<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema senza barra azioni: tutto lo schermo è della WebView. Lo sfondo scuro del
         tabellone si vede all'avvio e dietro le barre di sistema. -->
    <style name="Theme.VesuOra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/line</item>
        <item name="colorPrimaryDark">@color/board</item>
        <item name="colorAccent">@color/line</item>
        <item name="android:windowBackground">@color/board</item>
        <item name="android:statusBarColor">@color/board</item>
        <item name="android:navigationBarColor">@color/board</item>
    </style>
</resources>
